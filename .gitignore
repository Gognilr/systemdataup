# ---- 构建产物 ----
[Bb]in/
[Oo]bj/
publish/
*.user
*.suo
.vs/

# ---- 密钥与本机配置（禁止入库）----
prod_keys.txt
setup-env.ps1
appsettings.*.local.json
*.pfx
*.p12
*.key
# 仅指仓库根目录的开发 CA 目录（data/dev-ca.pfx）；
# 不锚定会误伤 src/src/BackupMonitor.Infrastructure/Data/（Windows 忽略匹配大小写不敏感）。
/data/

# ---- 运行时产物 ----
logs/
*.log

# ---- 构建产物与发布包（体积大，走 Releases，不入库）----
artifacts/
dist/*.exe
dist/prerequisites/*.exe
src/server/BackupMonitor.Server.Setup/payload/*.zip
src/src/BackupMonitor.Api/wwwroot/downloads/*.exe
src/src/BackupMonitor.Api/wwwroot/downloads/*.zip
