<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>BackupMonitor.Agent</RootNamespace>
    <AssemblyName>BackupMonitor.Agent</AssemblyName>
    <Version>1.3.2</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgentWorker 里真正容易写错的几块（进度节流、限速换算、缺块展开）都是嵌套私有类型。
         把它们开到 internal 并只对测试程序集可见，好过为了可测把实现细节变成公开 API。 -->
    <InternalsVisibleTo Include="BackupMonitor.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BackupMonitor.Shared\BackupMonitor.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BackupMonitor.Shared\Security\SecureFileSystem.cs" Link="Security\SecureFileSystem.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
