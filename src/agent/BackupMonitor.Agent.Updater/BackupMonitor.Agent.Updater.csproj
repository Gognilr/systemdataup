<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BackupMonitor.Agent.Updater</RootNamespace>
    <AssemblyName>BackupMonitor.Agent.Updater</AssemblyName>
    <Version>1.3.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 单文件发布：它装在安装目录**之外**的同级目录里（升级包覆盖不到它，
         否则换文件时它自己也会被锁），单文件能让那个目录的安装与卸载只管一个文件。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackupMonitor.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
