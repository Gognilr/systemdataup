<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- 刻意不引 Testcontainers / Npgsql：这个项目里的用例必须在没有 Docker 的机器上
       秒级跑完并且全绿。Infrastructure.Tests 里一百多条用例在无 Docker 环境下是红的，
       红成常态之后没人会再去看它，Agent 的回归就是这么漏出去的。 -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\agent\BackupMonitor.Agent\BackupMonitor.Agent.csproj" />
  </ItemGroup>

</Project>
