<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BackupMonitor.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SecureFileSystem is linked into the Windows-aware API and Agent projects.
      Shared is also built for non-Windows targets where the BCL surface for
      FileSystemSecurity is not available without an additional package.
    -->
    <Compile Remove="Security\SecureFileSystem.cs" />
  </ItemGroup>

</Project>
