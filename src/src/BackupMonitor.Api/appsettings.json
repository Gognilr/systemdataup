{
  "_secrets": "机密一律不写入本文件。开发用 dotnet user-secrets，生产用环境变量（Security__Jwt__SigningKey / Security__CommandSigningPrivateKey / Security__ClientCa__Password / ConnectionStrings__Default），见 setup-env.ps1。",
  "ConnectionStrings": {
    "Default": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backup-monitor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {RequestId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Security": {
    "Jwt": {
      "SigningKey": "",
      "Issuer": "BackupMonitor",
      "Audience": "BackupMonitor",
      "AccessTokenTtlSeconds": 3600,
      "RefreshTokenTtlDays": 7
    },
    "CommandSigningPrivateKey": "",
    "AllowLegacyCommandHmac": false,
    "ClientCa": {
      "CertPath": "",
      "Password": "",
      "ClientCertValidityDays": 365
    },
    "ClientAuth": {
      "AllowDevelopmentHeader": false
    }
  },
  "Storage": {
    "RepositoryPath": "",
    "StagingPath": ""
  },
  "Reports": {
    "Timezone": "Asia/Shanghai"
  },
  "AllowedHosts": "*"
}
